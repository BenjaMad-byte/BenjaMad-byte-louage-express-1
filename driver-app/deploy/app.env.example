# Application chauffeur — /etc/louage/app.env (droits 600, propriétaire root). Ne jamais le mettre dans git.
# Les valeurs « CHANGE_ME » doivent être remplacées (node ../driver-portal/deploy/secrets.js en génère).
NODE_ENV=production
PORT=4200
# Écoute locale seulement : seul le proxy (Caddy / nginx) est joignable de l'extérieur.
HOST=127.0.0.1
# Nombre de proxys devant l'application (1 derrière Caddy ou nginx).
TRUST_PROXY=1
# Adresse publique de l'application (https obligatoire).
PUBLIC_URL=https://chauffeur.exemple.tn

# Base de données de l'application (SQLite) : un volume CHIFFRÉ, comme celui du site d'inscription.
DATA_DIR=/srv/louage/app-data

# --- Site d'inscription : qui est un chauffeur accepté ? ---
# Même machine : http://127.0.0.1:4100. APP_SERVICE_KEY = la même valeur que dans l'environnement du site d'inscription.
PORTAL_URL=http://127.0.0.1:4100
APP_SERVICE_KEY=CHANGE_ME
# Clé de l'onglet « Exploitation » de la console d'administration (APP_OPS_KEY de son côté). DIFFÉRENTE de APP_SERVICE_KEY.
OPS_SERVICE_KEY=CHANGE_ME

# --- Code de vérification du téléphone par SMS ---
OTP_SECRET=CHANGE_ME
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_FROM=CHANGE_ME
# TWILIO_MESSAGING_SERVICE_SID=
SMS_DAILY_CAP=200

# --- SOS ---
# Numéros (8 chiffres, séparés par des virgules) de la PERMANENCE qui reçoit les alertes SOS par SMS, répétées toutes les 2 minutes
# jusqu'à l'accusé de réception dans la console. OBLIGATOIRE. N'active pas le SOS auprès des chauffeurs sans une personne réellement de garde.
SOS_ALERT_PHONES=
# Numéros affichés dans l'application (le chauffeur touche pour appeler). « Libellé=numéro », séparés par des virgules. À VÉRIFIER.
# EMERGENCY_NUMBERS=Police=197,Protection civile=198,SAMU=190

# --- Réservations en ligne (désactivées) ---
# RESERVATIONS=on exige un VRAI fournisseur SVA : seule une simulation existe aujourd'hui et elle est interdite en production.
# RESERVATIONS=off
# SVA_PROVIDER=
# SVA_CALLBACK_SECRET=

# Origines supplémentaires autorisées à écrire dans l'API (séparées par des virgules). Vide : seul le site lui-même.
# ALLOWED_ORIGINS=
