{
  "name": "louage-express-driver-app",
  "version": "0.1.0",
  "private": true,
  "description": "Application chauffeur (PWA) et service d'exploitation : file d'attente, places par tronçon, hors ligne, SOS, réservations.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "test:e2e": "node --test \"e2e/*.e2e.js\"",
    "check": "node ../driver-portal/tools/check-repo.js .",
    "ci": "npm run check && npm test && npm run test:e2e"
  },
  "dependencies": {
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "axe-core": "^4.14.0",
    "playwright-core": "^1.63.0"
  }
}
