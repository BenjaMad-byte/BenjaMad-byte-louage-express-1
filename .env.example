# Secrets pour docker-compose (usage local/dev uniquement). Copier en .env et remplacer les valeurs,
# ou laisser tel quel pour un essai rapide (jamais pour un vrai déploiement public).
ADMIN_TOKEN=CHANGE_ME
APP_SERVICE_KEY=CHANGE_ME
OPS_SERVICE_KEY=CHANGE_ME
PORTAL_OTP_SECRET=CHANGE_ME
APP_OTP_SECRET=CHANGE_ME
# Chiffrement des pièces d'identité et des selfies (driver-portal) au repos : 32 octets en hexadécimal.
# Générer avec : node driver-portal/deploy/secrets.js   (reprendre seulement la ligne DATA_KEY)
# La perdre = perdre définitivement les pièces déjà enregistrées. La sauvegarder HORS du serveur
# (gestionnaire de mots de passe + copie papier), jamais dans ce fichier une fois renseignée pour de vrai.
DATA_KEY=CHANGE_ME
# Pendant une rotation de clé seulement : l'ancienne valeur de DATA_KEY (voir driver-portal/deploy/DEPLOY.md § Rotation).
# DATA_KEY_PREVIOUS=
