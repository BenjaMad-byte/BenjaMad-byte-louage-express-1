# Fichier d'environnement du portail chauffeurs — À COPIER vers /etc/louage/portal.env (propriétaire root, chmod 600).
# Ne jamais le mettre dans git. Les valeurs « CHANGE_ME » doivent être remplacées (node deploy/secrets.js les génère).

NODE_ENV=production
HOST=127.0.0.1
PORT=4100
# Nombre de proxys devant l'application : 1 derrière Caddy ou nginx. Sans lui, le HTTPS forcé redirige en boucle.
TRUST_PROXY=1

# Adresse publique du site (aperçus WhatsApp, plan du site). Le même nom que dans le Caddyfile / nginx.conf.
PUBLIC_URL=https://inscription.exemple.tn

# Volume CHIFFRÉ (voir DEPLOY.md, étape 3). Base SQLite + pièces des chauffeurs.
DATA_DIR=/srv/louage/data

# --- Secrets (générer avec : node deploy/secrets.js) ---
ADMIN_TOKEN=CHANGE_ME
# Clé de chiffrement des pièces. La perdre = perdre les pièces. Sauvegarde hors du serveur obligatoire.
DATA_KEY=CHANGE_ME
# Uniquement PENDANT une rotation de clé (voir DEPLOY.md, section 9) : l'ancienne clé, en lecture seule. Plusieurs : séparées par des virgules.
# DATA_KEY_PREVIOUS=
OTP_SECRET=CHANGE_ME
# Identique dans l'environnement du backend KYC.
KYC_SERVICE_KEY=CHANGE_ME

# --- Accès à la console /admin ---
# IP autorisées (séparées par des virgules). Fortement recommandé.
ADMIN_ALLOWED_IPS=

# --- SMS (code de vérification du téléphone) ---
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_FROM=CHANGE_ME
# Ou, à la place de TWILIO_FROM : un service de messagerie Twilio (expéditeur alphanumérique, plusieurs numéros).
# TWILIO_MESSAGING_SERVICE_SID=
SMS_DAILY_CAP=200

# --- Vérification d'identité (backend KYC, même machine) ---
KYC_BACKEND_URL=http://127.0.0.1:4000

# --- Pages légales (confidentialité, conditions, mentions) : informations PUBLIQUES de l'éditeur, obligatoires ---
# Le démarrage est refusé tant qu'elles manquent : aucune identité n'est inventée dans les textes.
LEGAL_ENTITY=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_HOST=
# Durées de conservation, en mois (décision D5 du plan) : dossier refusé ou abandonné ; chauffeur accepté après la fin de la collaboration.
LEGAL_RETENTION_REJECTED_MONTHS=
LEGAL_RETENTION_APPROVED_MONTHS=
# Jours de conservation des sauvegardes : la MÊME valeur que KEEP_DAYS de backup.sh (14 par défaut). La politique l'annonce.
LEGAL_BACKUP_DAYS=
# Facultatifs : affichés dans les mentions légales s'ils sont renseignés.
LEGAL_PHONE=
LEGAL_REGISTRATION=
LEGAL_PUBLISHER=

# --- SMS de notification (statut du dossier, confirmation et rappel d'entretien) ---
# DÉSACTIVÉS tant que la ligne suivante n'est pas « on ». Chaque SMS a un coût et envoie le numéro du chauffeur chez le prestataire SMS.
SMS_NOTIFICATIONS=off
NOTIFY_DAILY_CAP=300
NOTIFY_REMINDER_HOURS=3

# --- Entretiens : créneaux proposés (valeurs par défaut ci-dessous, heure de Tunis) ---
# SLOT_DAYS=7
# SLOT_START_HOUR=9
# SLOT_END_HOUR=17
# SLOT_MINUTES=30
# SLOT_NOTICE_MINUTES=120

# --- Application chauffeur (service séparé) ---
# Clé partagée avec l'application chauffeur (APP_SERVICE_KEY de son côté). Vide : l'application chauffeur ne peut pas interroger le portail.
# Elle ne reçoit que les chauffeurs acceptés, avec nom, téléphone, plaque et ligne : jamais CIN, photos ni consentements.
APP_SERVICE_KEY=

# Application chauffeur (onglet « Exploitation » de la console : files, voyages, alertes SOS). Même machine : http://127.0.0.1:4200.
# APP_OPS_KEY = OPS_SERVICE_KEY de l'application chauffeur (une clé DIFFÉRENTE de APP_SERVICE_KEY).
APP_URL=
APP_OPS_KEY=

# --- Divers ---
# Origines supplémentaires autorisées à écrire dans l'API (séparées par des virgules). Vide : seul le site lui-même.
# ALLOWED_ORIGINS=
WHATSAPP_NUMBER=
JITSI_BASE=https://meet.jit.si
