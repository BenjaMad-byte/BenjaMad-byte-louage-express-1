# À COPIER vers /etc/louage/kyc.env (propriétaire root, chmod 600). Jamais dans git.
NODE_ENV=production
# Le backend KYC ne doit être joignable que par le portail, sur la même machine.
HOST=127.0.0.1
PORT=4000
# Identique à KYC_SERVICE_KEY du portail. Le backend refuse de démarrer en production sans elle.
KYC_SERVICE_KEY=CHANGE_ME

# Reconnaissance faciale AWS Rekognition (optionnel). Sans elle, le dossier reste « À examiner » : jamais accepté automatiquement.
# ATTENTION : activer AWS envoie le visage et la CIN hors de Tunisie. À couvrir par l'INPDP AVANT d'activer.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REKOGNITION_REGION=eu-west-1
